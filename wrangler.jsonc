{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "developer-workflow-os",
	"main": "app/cloudflare/worker.js",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./app/dashboard",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sdlc-db",
			"database_id": "3695ebbd-6ff6-4b49-8c51-ebfd362003e0"
		}
	],

	"vars": {
		"ENVIRONMENT": "production"
	}
}